      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name, redis_mode) (rate(zglosto_redis_operation_duration_seconds_bucket[5m])))",
