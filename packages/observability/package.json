{
  "name": "@zglosto/observability",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./dist/register.js"
  },
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.build.json",
    "test": "bun run --bun vitest run src",
    "typecheck": "bun run --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.8.1"
  }
}
