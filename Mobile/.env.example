# Public edge used by the native client. Never place server secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_ORIGIN=https://example-city.invalid

# Set to true only for a local development origin. For the restricted Phase 3.2
# proxy use http://127.0.0.1:18135 on iOS Simulator and
# http://10.0.2.2:18135 on Android Emulator.
EXPO_PUBLIC_ALLOW_HTTP_ORIGIN=false

# Optional build-time DNS host owned by the project. Keep empty until both
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json are live.
MOBILE_APP_LINK_HOST=
