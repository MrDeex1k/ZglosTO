NODE_ENV=test

POSTGRES_USER=zglosto_test
POSTGRES_PASSWORD=phase0-integration-database-password
POSTGRES_DB=zglosto_db
POSTGRES_PORT=54325
DATABASE_URL=postgresql://zglosto_test:phase0-integration-database-password@pgbouncer:6432/zglosto_db
DATABASE_DIRECT_URL=postgresql://zglosto_test:phase0-integration-database-password@database:54325/zglosto_db
DATABASE_TLS_CA_PATH=/run/secrets/database/ca.crt
RABBITMQ_USER=zglosto_test
RABBITMQ_PASSWORD=phase0-integration-rabbitmq-password
RABBITMQ_VHOST=zglosto
RABBITMQ_URL=amqps://zglosto_test:phase0-integration-rabbitmq-password@rabbitmq:5671/zglosto
RABBITMQ_TLS_CA_PATH=/run/secrets/service/ca.crt
RABBITMQ_SERVER_NAME=rabbitmq
RABBITMQ_HEARTBEAT_SECONDS=10
RABBITMQ_RECONNECT_DELAY_MS=250
RABBITMQ_PUBLISHER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_BATCH_SIZE=10
OUTBOX_LOCK_TIMEOUT_MS=1000
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=30
PGBOUNCER_DEFAULT_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=2
PGBOUNCER_MAX_PREPARED_STATEMENTS=50

S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://uploads.localhost:11335
S3_REGION=eu-central-1
S3_BUCKET=zglosto-integration
S3_ACCESS_KEY_ID=zglosto-integration-access-key
S3_SECRET_ACCESS_KEY=zglosto-integration-secret-key
S3_FORCE_PATH_STYLE=true
S3_OBJECT_PREFIX=incidents
S3_AUTO_CREATE_BUCKET=true

BETTER_AUTH_SECRET=phase0-integration-secret-000000000000000000000000
BETTER_AUTH_URL=http://localhost:11335
AUTH_SERVICE_URL=https://authorization:9956
AUTH_SERVICE_CA_PATH=/run/secrets/service/ca.crt
AUTH_SERVICE_CERT_PATH=/run/secrets/service/backend-client.crt
AUTH_SERVICE_KEY_PATH=/run/secrets/service/backend-client.key
AUTH_SERVICE_SERVER_NAME=authorization
AUTH_SERVICE_TIMEOUT_MS=5000
AUTHORIZATION_MTLS_PORT=9956
AUTHORIZATION_MTLS_CA_PATH=/run/secrets/service/ca.crt
AUTHORIZATION_MTLS_CERT_PATH=/run/secrets/service/authorization-server.crt
AUTHORIZATION_MTLS_KEY_PATH=/run/secrets/service/authorization-server.key
AUTHORIZATION_MTLS_BACKEND_IDENTITY=spiffe://zglosto.local/workload/backend
AUTHORIZATION_MTLS_HEALTHCHECK_IDENTITY=spiffe://zglosto.local/workload/authorization-healthcheck
AUTHORIZATION_MTLS_NGINX_IDENTITY=spiffe://zglosto.local/workload/nginx
AUTHORIZATION_HEALTHCHECK_CA_PATH=/run/secrets/service/ca.crt
AUTHORIZATION_HEALTHCHECK_CERT_PATH=/run/secrets/service/authorization-healthcheck-client.crt
AUTHORIZATION_HEALTHCHECK_KEY_PATH=/run/secrets/service/authorization-healthcheck-client.key
AUTHORIZATION_HEALTHCHECK_SERVER_NAME=authorization
FRONTEND_ORIGIN=http://localhost:11335
EMAIL_DELIVERY_MODE=test

LLM_GATEWAY_URL=https://llm_gateway:8130
LLM_TIMEOUT_MS=500

VITE_API_BASE_URL=/api
VITE_LLM_BASE_URL=/llm
