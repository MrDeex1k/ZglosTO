{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "docs-site#build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**/*.md"],
      "env": ["PUBLIC_SITE_URL"],
      "outputs": ["dist/**"]
    },
    "docs-site#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**/*.md"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "EXPO_PUBLIC_ALLOW_HTTP_ORIGIN",
        "EXPO_PUBLIC_API_ORIGIN",
        "EXPO_PUBLIC_APP_ENV",
        "VITE_API_BASE_URL",
        "WHITE_LABEL_CONFIG"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
