# Runtime
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=zglosto_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=zglosto_db
POSTGRES_PORT=54325
# Application traffic always goes through PgBouncer.
DATABASE_URL=postgresql://zglosto_user:replace-with-a-long-random-database-password@pgbouncer:6432/zglosto_db
# Operations only: migrations, backup/restore and controlled administration.
DATABASE_DIRECT_URL=postgresql://zglosto_user:replace-with-a-long-random-database-password@database:54325/zglosto_db
DATABASE_TLS_CA_PATH=/run/secrets/database/ca.crt
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# Redis is optional. disabled keeps the always-on local rate limiters.
REDIS_MODE=disabled
# Select one override when enabling Redis:
#   docker-compose.redis.local.yml    — ZgłosTO starts redis:8.10.0-alpine3.23
#   docker-compose.redis.external.yml — operator supplies a verified rediss:// endpoint
# Host-side secret files consumed by those overrides:
# REDIS_URL_SECRET_FILE=./secrets/development/redis-url
# RATE_LIMIT_HMAC_KEY_SECRET_FILE=./secrets/development/rate-limit-hmac
# REDIS_ACL_FILE=./secrets/development/redis-users.acl
# REDIS_TLS_CA_FILE=./secrets/development/redis-ca.crt
REDIS_IMAGE=redis:8.10.0-alpine3.23
REDIS_MAXMEMORY=256mb
# Required only in local/external mode. The file contains the complete Redis URL.
# REDIS_URL_FILE=/run/secrets/redis/url
# Required only in local/external mode. Use the same random 32+ byte key in every replica.
# RATE_LIMIT_HMAC_KEY_FILE=/run/secrets/redis/rate-limit-hmac
# Required when the Redis URL uses TLS with a private CA.
# REDIS_TLS_CA_PATH=/run/secrets/redis/ca.crt
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_KEY_PREFIX=zglosto
# Compose has one trusted Nginx hop. Kubernetes/K3s set this to 2 for Ingress + Nginx.
CLIENT_IP_TRUSTED_PROXY_HOPS=1

# Public homepage cache contract.
HOMEPAGE_CACHE_TTL_SECONDS=900
HOMEPAGE_NGINX_MICROCACHE_SECONDS=30
HOMEPAGE_NGINX_DISABLED_TTL_SECONDS=900

# Always-on Authorization burst limiter. Better Auth keeps its own semantic limits.
AUTH_LOCAL_RATE_LIMIT_WINDOW_MS=1000
AUTH_LOCAL_RATE_LIMIT_MAX_REQUESTS=50
AUTH_LOCAL_RATE_LIMIT_MAX_KEYS=50000
AUTH_LOCAL_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# Public incident submission limits. Initial values will be load-tested in Phase 12.
INCIDENT_LOCAL_RATE_LIMIT_WINDOW_MS=10000
INCIDENT_LOCAL_RATE_LIMIT_MAX_REQUESTS=5
INCIDENT_LOCAL_RATE_LIMIT_MAX_KEYS=50000
INCIDENT_LOCAL_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
INCIDENT_IP_RATE_LIMIT_WINDOW_MS=900000
INCIDENT_IP_RATE_LIMIT_MAX_REQUESTS=10
INCIDENT_USER_RATE_LIMIT_WINDOW_MS=900000
INCIDENT_USER_RATE_LIMIT_MAX_REQUESTS=20
INCIDENT_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
INCIDENT_GLOBAL_RATE_LIMIT_MAX_REQUESTS=300

# RabbitMQ uses TLS-only AMQP inside the private network.
RABBITMQ_USER=zglosto_backend
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_VHOST=zglosto
RABBITMQ_URL=amqps://zglosto_backend:replace-with-a-long-random-rabbitmq-password@rabbitmq:5671/zglosto
RABBITMQ_TLS_CA_PATH=/run/secrets/service/ca.crt
RABBITMQ_SERVER_NAME=rabbitmq
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_RECONNECT_DELAY_MS=1000
RABBITMQ_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_TIMEOUT_MS=30000

# Standalone NestJS media worker (no public HTTP listener).
MEDIA_WORKER_HEALTH_FILE=/tmp/zglosto-media-worker.json
MEDIA_WORKER_HEALTH_INTERVAL_MS=5000
MEDIA_WORKER_HEALTH_STALE_MS=20000
MEDIA_WORKER_DATABASE_POOL_MAX=2
MEDIA_WORKER_PREFETCH=1
MEDIA_MAX_INPUT_BYTES=5242880
MEDIA_MAX_INPUT_WIDTH=8192
MEDIA_MAX_INPUT_HEIGHT=8192
MEDIA_MAX_INPUT_PIXELS=32000000
MEDIA_MAX_OUTPUT_DIMENSION=2000
MEDIA_SHARP_CONCURRENCY=1
MEDIA_WEBP_QUALITY=85
MEDIA_WEBP_EFFORT=4

# S3-compatible Object Storage. The default docker-compose.yml starts local RustFS.
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://uploads.127.0.0.1.nip.io:1235
S3_UPLOAD_EXPIRY_SECONDS=300
S3_REGION=eu-central-1
S3_BUCKET=zglosto-local
S3_ACCESS_KEY_ID=replace-with-a-long-random-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-storage-secret-key
S3_FORCE_PATH_STYLE=true
S3_OBJECT_PREFIX=incidents
# The local RustFS override may create the bucket. Use false for an external bucket.
S3_AUTO_CREATE_BUCKET=true

# Authorization / Better Auth
AUTHORIZATION_MTLS_PORT=9956
AUTHORIZATION_MTLS_CA_PATH=/run/secrets/service/ca.crt
AUTHORIZATION_MTLS_CERT_PATH=/run/secrets/service/authorization-server.crt
AUTHORIZATION_MTLS_KEY_PATH=/run/secrets/service/authorization-server.key
AUTHORIZATION_MTLS_BACKEND_IDENTITY=spiffe://zglosto.local/workload/backend
AUTHORIZATION_MTLS_HEALTHCHECK_IDENTITY=spiffe://zglosto.local/workload/authorization-healthcheck
AUTHORIZATION_MTLS_NGINX_IDENTITY=spiffe://zglosto.local/workload/nginx
AUTHORIZATION_HEALTHCHECK_CA_PATH=/run/secrets/service/ca.crt
AUTHORIZATION_HEALTHCHECK_CERT_PATH=/run/secrets/service/authorization-healthcheck-client.crt
AUTHORIZATION_HEALTHCHECK_KEY_PATH=/run/secrets/service/authorization-healthcheck-client.key
AUTHORIZATION_HEALTHCHECK_SERVER_NAME=authorization
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:1235
AUTH_SERVICE_URL=https://authorization:9956
AUTH_SERVICE_CA_PATH=/run/secrets/service/ca.crt
AUTH_SERVICE_CERT_PATH=/run/secrets/service/backend-client.crt
AUTH_SERVICE_KEY_PATH=/run/secrets/service/backend-client.key
AUTH_SERVICE_SERVER_NAME=authorization
AUTH_SERVICE_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:1235
EMAIL_DELIVERY_MODE=disabled

# One immutable White-Label YAML mounted into each application service.
WHITE_LABEL_CONFIG=/app/config/city.yaml

# LLM
LLM_RUNTIME=disabled
LLM_GATEWAY_URL=https://llm_gateway:8130
LLM_GATEWAY_CA_PATH=/run/secrets/service/ca.crt
LLM_GATEWAY_CERT_PATH=/run/secrets/service/backend-client.crt
LLM_GATEWAY_KEY_PATH=/run/secrets/service/backend-client.key
LLM_GATEWAY_SERVER_NAME=llm-gateway
LLM_GATEWAY_HMAC_KEY_FILE=/run/secrets/llm-auth/hmac-key
LLM_GATEWAY_HMAC_KEY_ID=backend-v1
LLM_GATEWAY_AUTH_CLOCK_SKEW_SECONDS=30
LLM_GATEWAY_AUTH_REPLAY_MAX_ENTRIES=10000
LLM_GATEWAY_MAX_BODY_BYTES=32768
LLM_GATEWAY_MAX_CONCURRENT_CLASSIFICATIONS=4
LLM_UPSTREAM_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=7000
# Used only by the optional docker-compose.llm.yml override.
DOCKER_MODEL_RUNNER_URL=http://model-runner.docker.internal:12434
DOCKER_MODEL_RUNNER_MODEL=ai/gemma3-qat:1B-Q4_K_M
DOCKER_MODEL_RUNNER_ENGINE=llama.cpp
DOCKER_MODEL_RUNNER_TEMPERATURE=0.1
DOCKER_MODEL_RUNNER_MAX_TOKENS=64

# Observability is opt-in. Topology is selected with a Compose override or Kustomize overlay.
OBSERVABILITY_MODE=disabled
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_SERVICE_VERSION=development
# External mode only:
# OTEL_EXTERNAL_ENDPOINT=https://otlp.example.invalid
# OTEL_EXTERNAL_AUTH_HEADER_NAME=Authorization
# OTEL_EXTERNAL_AUTHORIZATION_FILE=./secrets/otel-authorization
# Local mode only:
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana-admin-password
# GRAFANA_PORT=3001

# Public browser paths are compiled from frontend/.env.production.
# VITE_API_BASE_URL=/api
# VITE_LLM_BASE_URL=/llm
