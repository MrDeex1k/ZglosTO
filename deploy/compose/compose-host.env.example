PRODUCTION_ENV_FILE=/etc/zglosto/production.env
PRODUCTION_STATE_DIR=/var/lib/zglosto-compose
PRODUCTION_BACKUP_ROOT=/var/backups/zglosto
PRODUCTION_BACKUP_RETENTION_COUNT=7
PRODUCTION_WAIT_TIMEOUT_SECONDS=300
# For the first deployment, point this at the candidate generated by
# `pnpm build:production`. After promotion the script defaults to
# /var/lib/zglosto-compose/current.images.env and its matching manifest.
# PRODUCTION_IMAGES_ENV_FILE=/opt/zglosto/current/.state/production-build/candidate/images.env
# PRODUCTION_BUILD_MANIFEST_FILE=/opt/zglosto/current/.state/production-build/candidate/manifest.json
