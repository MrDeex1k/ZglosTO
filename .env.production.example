# This file contains public production configuration only. Never add secret values here.
# Copy it outside the repository, replace every example value and pass it with --env-file.

COMPOSE_PROJECT_NAME=zglosto-production
HTTPS_PORT=443
PUBLIC_BASE_URL=https://zglosto.example.invalid
ZTO_SECRETS_DIR=./secrets/production
OBJECT_STORAGE_MODE=local
REDIS_MODE=disabled
OBSERVABILITY_MODE=disabled
LLM_MODE=disabled

# The eight application image references come exclusively from
# .state/production-build/candidate/images.env generated by `pnpm build:production`.
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-rc.2
REDIS_IMAGE=redis:8.10.0-alpine3.23

POSTGRES_USER=zglosto
POSTGRES_DB=zglosto
POSTGRES_PORT=54325
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

RABBITMQ_VHOST=zglosto

# Select docker-compose.redis.local.yml or docker-compose.redis.external.yml.
# The override mounts these host-side files at the runtime paths below.
# REDIS_URL_SECRET_FILE=./secrets/production/redis-url
# RATE_LIMIT_HMAC_KEY_SECRET_FILE=./secrets/production/rate-limit-hmac
# REDIS_ACL_FILE=./secrets/production/redis-users.acl
# REDIS_TLS_CA_FILE=./secrets/production/redis-ca.crt
REDIS_MAXMEMORY=256mb
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_KEY_PREFIX=zglosto
CLIENT_IP_TRUSTED_PROXY_HOPS=1

HOMEPAGE_CACHE_TTL_SECONDS=900
HOMEPAGE_NGINX_MICROCACHE_SECONDS=30
HOMEPAGE_NGINX_DISABLED_TTL_SECONDS=900

AUTH_LOCAL_RATE_LIMIT_WINDOW_MS=1000
AUTH_LOCAL_RATE_LIMIT_MAX_REQUESTS=50
AUTH_LOCAL_RATE_LIMIT_MAX_KEYS=50000
AUTH_LOCAL_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

INCIDENT_LOCAL_RATE_LIMIT_WINDOW_MS=10000
INCIDENT_LOCAL_RATE_LIMIT_MAX_REQUESTS=5
INCIDENT_LOCAL_RATE_LIMIT_MAX_KEYS=50000
INCIDENT_LOCAL_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
INCIDENT_IP_RATE_LIMIT_WINDOW_MS=900000
INCIDENT_IP_RATE_LIMIT_MAX_REQUESTS=10
INCIDENT_USER_RATE_LIMIT_WINDOW_MS=900000
INCIDENT_USER_RATE_LIMIT_MAX_REQUESTS=20
INCIDENT_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
INCIDENT_GLOBAL_RATE_LIMIT_MAX_REQUESTS=300

BETTER_AUTH_URL=https://zglosto.example.invalid
FRONTEND_ORIGIN=https://zglosto.example.invalid
EMAIL_DELIVERY_MODE=disabled

S3_ENDPOINT=https://s3.example.invalid
S3_PUBLIC_ENDPOINT=https://uploads.zglosto.example.invalid
S3_UPLOAD_EXPIRY_SECONDS=300
S3_REGION=eu-central-1
S3_BUCKET=zglosto-production
S3_FORCE_PATH_STYLE=false
S3_OBJECT_PREFIX=incidents
S3_AUTO_CREATE_BUCKET=false

LLM_RUNTIME=disabled
LLM_TIMEOUT_MS=7000
LLM_UPSTREAM_TIMEOUT_MS=5000
DOCKER_MODEL_RUNNER_URL=http://model-runner.invalid:12434
DOCKER_MODEL_RUNNER_MODEL=ai/gemma3-qat:1B-Q4_K_M
DOCKER_MODEL_RUNNER_ENGINE=llama.cpp
DOCKER_MODEL_RUNNER_TEMPERATURE=0.1
DOCKER_MODEL_RUNNER_MAX_TOKENS=64
# Required only for LLM_MODE=external.
# LLM_EXTERNAL_URL=https://llm.example.invalid/v1
# LLM_EXTERNAL_MODEL=municipal-classifier
# LLM_EXTERNAL_API_KEY_FILE=./secrets/production/llm-api-key
# LLM_EXTERNAL_TEMPERATURE=0.1
# LLM_EXTERNAL_MAX_TOKENS=64

OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_SERVICE_VERSION=replace-with-release-version
# Select exactly one optional override: external or local.
# OTEL_EXTERNAL_ENDPOINT=https://otlp.example.invalid
# OTEL_EXTERNAL_AUTH_HEADER_NAME=Authorization
# OTEL_EXTERNAL_AUTHORIZATION_FILE=./secrets/production/otel-authorization
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD_FILE=./secrets/production/grafana-admin-password
# GRAFANA_PORT=3001

DATABASE_POOL_MAX=10
MEDIA_WORKER_DATABASE_POOL_MAX=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_RECONNECT_DELAY_MS=1000
RABBITMQ_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LOCK_TIMEOUT_MS=30000

MEDIA_WORKER_PREFETCH=1
MEDIA_WORKER_HEALTH_INTERVAL_MS=5000
MEDIA_WORKER_HEALTH_STALE_MS=20000
MEDIA_MAX_INPUT_BYTES=5242880
MEDIA_MAX_INPUT_WIDTH=8192
MEDIA_MAX_INPUT_HEIGHT=8192
MEDIA_MAX_INPUT_PIXELS=32000000
MEDIA_MAX_OUTPUT_DIMENSION=2000
MEDIA_SHARP_CONCURRENCY=1
MEDIA_WEBP_QUALITY=85
MEDIA_WEBP_EFFORT=4
