{
  "name": "backend-zglosto",
  "version": "1.0.0",
  "private": true,
  "description": "Backend dla aplikacji ZglosTO",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/nest/main.js",
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.build.json",
    "dev": "bun ../scripts/dev-service.ts nest/main.js",
    "dev:media-worker": "bun ../scripts/dev-service.ts nest/media-worker/main.js",
    "start": "bun --preload @zglosto/observability/register dist/nest/main.js",
    "start:media-worker": "bun --preload @zglosto/observability/register dist/nest/media-worker/main.js",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "typecheck": "bun run --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@aws-sdk/s3-request-presigner": "3.1123.0",
    "@cloudamqp/amqp-client": "4.1.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/rate-limiting": "workspace:*",
    "@zglosto/transient-store": "workspace:*",
    "@zglosto/white-label-config": "workspace:*",
    "@zglosto/workload-auth": "workspace:*",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=26.8.1"
  }
}
