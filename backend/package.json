{
  "name": "backend-zglosto",
  "version": "1.0.0",
  "private": true,
  "description": "Backend dla aplikacji ZglosTO",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/nest/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import @zglosto/observability/register --watch nest/main.ts",
    "dev:media-worker": "node --import @zglosto/observability/register --watch nest/media-worker/main.ts",
    "start": "node --import @zglosto/observability/register dist/nest/main.js",
    "start:media-worker": "node --import @zglosto/observability/register dist/nest/media-worker/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@cloudamqp/amqp-client": "4.0.0",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/platform-express": "12.0.0-alpha.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/rate-limiting": "workspace:*",
    "@zglosto/transient-store": "workspace:*",
    "@zglosto/white-label-config": "workspace:*",
    "@zglosto/workload-auth": "workspace:*",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.0-alpha.5",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26.5.0"
  }
}
