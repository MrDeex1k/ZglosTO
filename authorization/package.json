{
  "name": "authorization-zglosto",
  "version": "1.0.0",
  "private": true,
  "description": "Authorization service for ZglosTO application",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.build.json",
    "dev": "bun --preload @zglosto/observability/register --watch server.ts",
    "start": "bun --preload @zglosto/observability/register dist/server.js",
    "test": "bun run --bun vitest run --dir src",
    "typecheck": "bun run --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@hono/node-server": "2.1.1",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/rate-limiting": "workspace:*",
    "@zglosto/transient-store": "workspace:*",
    "@zglosto/white-label-config": "workspace:*",
    "better-auth": "1.7.5",
    "hono": "4.13.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=26.8.1"
  }
}
