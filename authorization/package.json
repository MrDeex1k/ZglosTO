{
  "name": "authorization-zglosto",
  "version": "1.0.0",
  "private": true,
  "description": "Authorization service for ZglosTO application",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import @zglosto/observability/register --watch server.ts",
    "start": "node --import @zglosto/observability/register dist/server.js",
    "test": "vitest run --dir src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.29",
    "@hono/node-server": "2.1.1",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/rate-limiting": "workspace:*",
    "@zglosto/transient-store": "workspace:*",
    "@zglosto/white-label-config": "workspace:*",
    "better-auth": "1.6.29",
    "hono": "4.13.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26.5.0"
  }
}
