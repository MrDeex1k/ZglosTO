---
import DocsLayout from '../layouts/DocsLayout.astro';
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import { navigation } from '../lib/navigation';
const paths = [
  { number: '01', title: 'Uruchom lokalnie', description: 'Przygotuj środowisko i uruchom aplikację z Docker Compose.', href: '/docs/start/', detail: 'Od wymagań do pierwszego zgłoszenia' },
  { number: '02', title: 'Skonfiguruj miasto', description: 'Ustaw branding, katalog służb i konfigurację White-Label.', href: '/docs/konfiguracja/', detail: 'Jedna instalacja · jedno miasto' },
  { number: '03', title: 'Wybierz wdrożenie', description: 'Porównaj Compose, Kubernetes i K3s, a potem przejdź do instrukcji.', href: '/docs/wdrozenie/', detail: 'Wymagania, ograniczenia i odbiór' },
];
---
<DocsLayout title="Dokumentacja ZgłosTO" description="Korzystanie z aplikacji, konfiguracja, wdrożenie i utrzymanie platformy miejskiej."
  sidebar={navigation(Astro.url.pathname)} headings={false} breadcrumbs={[]} prevNext={{}}>
  <div slot="page-title" class="overview-intro" data-pagefind-ignore>
    <p class="section-label">Dokumentacja</p>
    <h1>ZgłosTO<span class="brand-dot">.</span></h1>
    <p class="intro-description">Korzystaj z aplikacji. Skonfiguruj swoje miasto.<br class="desktop-break" /> Znajdź instrukcje wdrożenia i codziennego utrzymania.</p>
    <button type="button" class="overview-search" data-search-trigger aria-label="Szukaj w dokumentacji">
      <Icon name="ph:magnifying-glass" class="size-5" />
      <span>Szukaj instrukcji, konfiguracji, polecenia…</span>
      <kbd><span data-shortcut-key>Ctrl</span> K</kbd>
    </button>
  </div>
  <div class="overview-body">
    <section aria-labelledby="begin-title">
      <div class="section-header"><h2 id="begin-title">Zacznij tutaj</h2><span>Trzy kroki do własnej instalacji</span></div>
      <div class="path-list">
        {paths.map((path) => <a class="path-row" href={path.href}>
          <span class="path-number">{path.number}</span>
          <span class="path-copy"><strong>{path.title}</strong><span>{path.description}</span><small>{path.detail}</small></span>
          <Icon name="ph:arrow-up-right" class="path-arrow size-5" />
        </a>)}
      </div>
    </section>
    <section class="reference-section" aria-labelledby="usage-title">
      <div class="section-header"><h2 id="usage-title">Korzystaj z aplikacji</h2><span>Przewodniki według roli i urządzenia</span></div>
      <div class="reference-columns">
        <div><h3>Mieszkaniec</h3><a href="/docs/mieszkaniec-web/">Zgłoszenie i historia w WEB <span>↗</span></a><a href="/docs/mieszkaniec-mobile/">Zgłoszenie i konto w Mobile <span>↗</span></a></div>
        <div><h3>Służby</h3><a href="/docs/sluzby-web/">Kolejka i statusy w WEB <span>↗</span></a><a href="/docs/sluzby-mobile/">Kolejka i zdjęcia w Mobile <span>↗</span></a></div>
        <div><h3>Administrator</h3><a href="/docs/administrator-web/">Sprawy i uprawnienia w WEB <span>↗</span></a></div>
      </div>
    </section>
    <section class="reference-section" aria-labelledby="reference-title">
      <div class="section-header"><h2 id="reference-title">Wdrożenie i rozwój</h2></div>
      <div class="reference-columns">
        <div><h3>Dla programisty</h3><a href="/docs/architektura/">Architektura i usługi <span>↗</span></a><a href="/docs/api/">Kontrakty API i sesji <span>↗</span></a><a href="/docs/granice-frontendu/">Granice frontendu i API <span>↗</span></a><a href="/docs/media/">Przetwarzanie zdjęć <span>↗</span></a><a href="/docs/zaleznosci/">Zależności i toolchain <span>↗</span></a></div>
        <div><h3>Dla operatora</h3><a href="/docs/healthchecki/">Healthchecki <span>↗</span></a><a href="/docs/diagnostyka/">Diagnostyka i smoke testy <span>↗</span></a><a href="/docs/monitoring/">Monitoring i logi <span>↗</span></a><a href="/docs/tls/">TLS i mTLS <span>↗</span></a><a href="/docs/redis/">Redis i degradacja <span>↗</span></a><a href="/docs/backup/">Backup i odtwarzanie <span>↗</span></a><a href="/docs/obrazy/">Obrazy kontenerowe <span>↗</span></a></div>
        <div><h3>Dla klienta Mobile</h3><a href="/docs/mobile-start/">Pierwsze uruchomienie <span>↗</span></a><a href="/docs/mobile-konfiguracja/">Konfiguracja klienta <span>↗</span></a><a href="/docs/mobile-build/">Build aplikacji <span>↗</span></a><a href="/docs/mobile-przekazanie/">Odbiór i przekazanie <span>↗</span></a></div>
      </div>
    </section>
    <footer class="overview-footer"><span>Kod źródłowy i archiwum decyzji</span><a href="https://github.com/MrDeex1k/ZglosTO/tree/main/docs" target="_blank" rel="noreferrer">Otwórz repozytorium ↗</a></footer>
  </div>
  <Fragment slot="pagination" />
</DocsLayout>
<style>
  .overview-intro { padding: 1.5rem 0 2.25rem; }
  .section-label { margin: 0 0 .7rem; color: var(--nb-primary); font-size: .75rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.75rem, 5vw, 4rem); font-weight: 740; letter-spacing: -.055em; line-height: 1.05; }
  .brand-dot { color: var(--nb-primary); }
  .intro-description { margin: 1rem 0 1.5rem; color: var(--nb-muted-foreground); font-size: 1.05rem; line-height: 1.65; }
  .overview-search { display: flex; align-items: center; gap: .8rem; width: 100%; min-height: 3.25rem; padding: .75rem 1rem; border: 1px solid var(--nb-border-strong); border-radius: .625rem; background: var(--nb-card); color: var(--nb-muted-foreground); text-align: left; font-size: .875rem; cursor: pointer; transition: border-color 150ms, background 150ms; }
  .overview-search:hover { border-color: var(--nb-primary); background: var(--nb-muted); }
  .overview-search kbd { margin-left: auto; white-space: nowrap; border: 1px solid var(--nb-border); border-radius: .25rem; padding: .15rem .35rem; font-size: .7rem; }
  .section-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: .85rem; }
  .section-header h2 { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -.02em; }
  .section-header > span { font-size: .75rem; color: var(--nb-muted-foreground); }
  .path-list { border-top: 1px solid var(--nb-border); }
  .path-row { display: grid; grid-template-columns: 2rem 1fr 1.25rem; gap: 1rem; padding: 1.25rem .25rem; border-bottom: 1px solid var(--nb-border); text-decoration: none; color: var(--nb-foreground); transition: background 150ms; }
  .path-row:hover { background: var(--nb-muted); }
  .path-number { padding-top: .1rem; color: var(--nb-primary); font-size: .8rem; }
  .path-copy { display: grid; gap: .35rem; }
  .path-copy strong { font-size: 1rem; font-weight: 620; }
  .path-copy > span { color: var(--nb-muted-foreground); font-size: .875rem; line-height: 1.6; }
  .path-copy small { color: var(--nb-muted-foreground); font-size: .7rem; }
  .path-arrow { color: var(--nb-muted-foreground); transition: color 150ms, transform 150ms; }
  .path-row:hover .path-arrow { color: var(--nb-primary); transform: translate(2px, -2px); }
  .reference-section { padding: 2.5rem 0 2rem; }
  .reference-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .reference-columns h3 { margin: .7rem 0; color: var(--nb-muted-foreground); font-size: .75rem; font-weight: 550; }
  .reference-columns a { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; color: var(--nb-foreground); font-size: .85rem; text-decoration: none; }
  .reference-columns a:hover { color: var(--nb-primary); }
  .reference-columns a span { color: var(--nb-muted-foreground); }
  .overview-footer { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--nb-border); padding-top: 1.25rem; color: var(--nb-muted-foreground); font-size: .75rem; }
  .overview-footer a { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 900px) { .reference-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .overview-intro { padding-top: .5rem; }
    .desktop-break, .section-header > span, .overview-search kbd { display: none; }
    .overview-search { font-size: .8rem; gap: .5rem; }
    .path-row { gap: .6rem; grid-template-columns: 1.5rem 1fr 1.25rem; }
    .reference-columns { grid-template-columns: 1fr; gap: 1rem; }
    .overview-footer { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .path-arrow, .path-row, .overview-search { transition: none; } }
</style>
