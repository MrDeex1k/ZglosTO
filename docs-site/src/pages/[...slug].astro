---
import DocsLayout from "../layouts/DocsLayout.astro";
import { navigation } from '../lib/navigation';
import { pages, repository } from '../../content-map.mjs';
import {
  getDocsStaticPaths,
  getDocsPageProps,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../components";
import type { PrevNext } from "@cloudflare/nimbus-docs/types";

export const prerender = true;
export const getStaticPaths = getDocsStaticPaths;

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug = '/' + (Astro.params.slug ?? '').replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  path.startsWith("/") && !path.startsWith(basePath) ? `${basePath}${path.slice(1)}` : path;
const withBaseForPrevNext = (value: PrevNext): PrevNext => ({
  prev: value.prev ? { ...value.prev, href: withBase(value.prev.href) } : value.prev,
  next: value.next ? { ...value.next, href: withBase(value.next.href) } : value.next,
});

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const rawSidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const sidebar = rawSidebar === false ? false : navigation(Astro.url.pathname);
const rawPrevNext = await getPrevNext(currentSlug, {
  sidebarTree: rawSidebar === false ? [] : rawSidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const prevNext = withBaseForPrevNext(rawPrevNext);
// Pass `collection` so versioned pages (docs-<v>) get version-prefixed
// breadcrumb hrefs — parity with the getSidebar call above.
const breadcrumbs = [{ label: 'Dokumentacja', href: '/docs/' }, { label: entry.data.title }];
const source = pages.find((page) => page.slug === entry.id)?.source;
const editUrl = source ? repository + source : await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
// `tocOn` already implies `tableOfContents !== false`, but TS can't carry
// that boolean narrowing to the value here — re-check it so `getTOC` only
// ever sees its options object (or undefined), never `false`.
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = withBase(`/${entry.id}/index.md`);
const markdownUrl = markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
