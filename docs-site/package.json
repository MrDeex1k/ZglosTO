{
  "name": "docs-site",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "check": "bun scripts/check.mjs",
    "dev": "bun scripts/sync-content.mjs && bun run --bun astro dev --host 127.0.0.1 --port 4322",
    "build": "bun scripts/sync-content.mjs && bun run --bun astro build",
    "preview": "bun run --bun astro preview",
    "typecheck": "bun scripts/sync-content.mjs && bun run --bun astro sync && bun run typecheck:ts && bun run typecheck:astro",
    "typecheck:ts": "bun run --bun tsc --noEmit -p tsconfig.json",
    "typecheck:astro": "bun scripts/check-astro.mjs",
    "lint:docs": "bun scripts/sync-content.mjs && bun run --bun nimbus-docs lint",
    "test": "bun test ./scripts/sync-content.test.mjs ./scripts/check-content.test.mjs ./scripts/typecheck.test.mjs --timeout 30000",
    "check:build": "bun scripts/check-build.mjs",
    "lint:docs:fix": "bun run --bun nimbus-docs lint --fix"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.3.3",
    "astro-og-canvas": "0.13.2",
    "canvaskit-wasm": "0.42.0",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/language-server": "2.17.0",
    "@tailwindcss/vite": "4.3.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-astro": "npm:typescript@6.0.3"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
