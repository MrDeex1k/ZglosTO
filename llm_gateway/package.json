{
  "name": "llm-gateway-zglosto",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "bun run --bun tsc -p tsconfig.build.json",
    "dev": "bun --preload @zglosto/observability/register --watch src/server.ts",
    "start": "bun --preload @zglosto/observability/register dist/src/server.js",
    "test": "bun run --bun vitest run",
    "typecheck": "bun run --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/workload-auth": "workspace:*",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=26.8.1"
  }
}
