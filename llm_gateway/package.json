{
  "name": "llm-gateway-zglosto",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import @zglosto/observability/register --watch src/server.ts",
    "start": "node --import @zglosto/observability/register dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@zglosto/contracts": "workspace:*",
    "@zglosto/observability": "workspace:*",
    "@zglosto/workload-auth": "workspace:*",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26.5.0"
  }
}
