{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
