{
  "name": "zglosto",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:production": "./scripts/production-build.sh build",
    "check": "pnpm check:source && pnpm check:dead-code && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:white-label-builds && pnpm build",
    "certs:dev": "./scripts/generate-dev-certificates.sh",
    "check:source": "./scripts/check-typescript-source.sh && ./scripts/check-single-city-architecture.sh && node scripts/check-public-repository.ts && node scripts/check-mobile-build-assets.ts && node scripts/sync-k8s-white-label.ts --check && node scripts/check-deployment-baseline.ts && node scripts/check-image-contract.ts && node scripts/check-production-source-build.ts && node scripts/check-cluster-configuration.ts && node scripts/check-cluster-stateful-services.ts && node scripts/check-cluster-workloads-security.ts && node scripts/check-observability-profiles.ts && node scripts/check-cluster-autoscaling.ts && node scripts/check-redis-profiles.ts && node scripts/check-redis-resilience.ts && node scripts/check-production-compose.ts .env.production.example --images-env deploy/compose/images.env.example --matrix && node scripts/test-production-compose-policy.ts && node scripts/check-phase-12.ts && ./scripts/check-frontend-boundary.sh && ./scripts/test-frontend-boundary-policy.sh && ./scripts/check-frontend-design-system.sh && ./scripts/test-frontend-design-system-policy.sh",
    "check:cluster-config": "node scripts/check-cluster-configuration.ts",
    "check:cluster-stateful": "node scripts/check-cluster-stateful-services.ts",
    "check:cluster-workloads-security": "node scripts/check-cluster-workloads-security.ts",
    "check:deployment-baseline": "node scripts/check-deployment-baseline.ts",
    "check:dead-code": "pnpm --filter @zglosto/contracts build && pnpm --filter @zglosto/white-label-config build && ZGLOSTO_STATIC_ANALYSIS=1 knip",
    "check:image-contract": "node scripts/check-image-contract.ts",
    "check:images:local": "node scripts/check-image-contract.ts --inspect --mode baseline",
    "check:images:target": "node scripts/check-image-contract.ts --inspect --mode target",
    "check:observability": "node scripts/check-observability-profiles.ts",
    "check:redis": "node scripts/check-redis-profiles.ts",
    "check:redis-resilience": "node scripts/check-redis-resilience.ts",
    "check:cluster-autoscaling": "node scripts/check-cluster-autoscaling.ts",
    "check:production-compose": "node scripts/check-production-compose.ts .env.production.example --images-env deploy/compose/images.env.example --matrix",
    "check:production-build": "node scripts/check-production-source-build.ts",
    "check:phase12": "node scripts/check-phase-12.ts",
    "check:public-repository": "node scripts/check-public-repository.ts",
    "check:mobile-build-assets": "node scripts/check-mobile-build-assets.ts",
    "check:mobile-client-configs": "pnpm --filter @zglosto/contracts build && pnpm --filter @zglosto/white-label-config build && node scripts/check-mobile-client-configs.mjs",
    "validate:production-build": "./scripts/production-build.sh validate",
    "config:metadata": "pnpm --filter @zglosto/white-label-config build && pnpm --filter @zglosto/white-label-config metadata",
    "config:k8s:sync": "node scripts/sync-k8s-white-label.ts",
    "deps:add": "sfw pnpm add --save-exact",
    "deps:install": "sfw pnpm install",
    "deps:update": "sfw pnpm update --recursive --latest",
    "dev:authorization": "pnpm --filter authorization-zglosto dev",
    "dev:backend": "pnpm --filter backend-zglosto dev",
    "dev:frontend": "pnpm --filter frontend-zglosto dev",
    "mobile:demo:android": "./scripts/mobile-demo.sh android",
    "mobile:demo:check": "./scripts/mobile-demo.sh check",
    "mobile:demo:clean": "./scripts/mobile-demo.sh clean",
    "mobile:demo:down": "./scripts/mobile-demo.sh down",
    "mobile:demo:ios": "./scripts/mobile-demo.sh ios",
    "mobile:demo:seed": "./scripts/mobile-demo.sh seed",
    "mobile:demo:status": "./scripts/mobile-demo.sh status",
    "mobile:demo:up": "./scripts/mobile-demo.sh up",
    "mobile:regression": "./Mobile/scripts/run-phase7-regression.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky || true",
    "test": "turbo run test",
    "test:white-label-builds": "./scripts/test-white-label-builds.sh",
    "test:integration": "./scripts/test-phase0-integration.sh",
    "test:redis-failure": "./scripts/test-redis-failure.sh",
    "test:deployment:compose": "./scripts/test-phase0-integration.sh",
    "test:deployment:kubernetes": "./scripts/test-cluster-profile.sh kubernetes",
    "test:deployment:k3s": "./scripts/test-cluster-profile.sh k3s",
    "typecheck": "turbo run typecheck && pnpm typecheck:integration",
    "typecheck:integration": "tsc -p tests/integration/tsconfig.json --noEmit",
    "quality:phase1": "pnpm check && pnpm test:integration",
    "release:production:static": "./scripts/production-release-gate.sh static",
    "release:production:validate": "./scripts/production-release-gate.sh validate",
    "release:production:runtime": "./scripts/production-release-gate.sh runtime",
    "test:production-compose-policy": "node scripts/test-production-compose-policy.ts",
    "audit:release": "node scripts/check-release-dependency-risk.ts",
    "release:manifest": "node scripts/generate-release-file-manifest.ts",
    "release:verify-source-copy": "node scripts/verify-release-source-copy.ts",
    "phase12:static": "./scripts/phase12-certify.sh static",
    "phase12:host": "./scripts/phase12-certify.sh host",
    "phase12:dmr": "./scripts/phase12-certify.sh dmr",
    "phase12:edge": "./scripts/phase12-certify.sh edge",
    "phase12:soak": "./scripts/phase12-certify.sh soak",
    "phase12:observability": "./scripts/phase12-certify.sh observability",
    "phase12:integration:minimal": "./scripts/phase12-certify.sh integration-minimal",
    "phase12:integration:recommended": "./scripts/phase12-certify.sh integration-recommended",
    "phase12:load": "./scripts/phase12-certify.sh load",
    "phase12:resources:minimal": "./scripts/phase12-resource-profile.sh minimal",
    "phase12:resources:observability": "./scripts/phase12-resource-profile.sh observability",
    "phase12:resources:recommended": "./scripts/phase12-resource-profile.sh recommended",
    "phase12:production": "./scripts/phase12-certify.sh production-runtime"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "sfw": "2.0.6",
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.5.0"
  },
  "packageManager": "pnpm@11.22.0"
}
