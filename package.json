{
  "name": "zglosto",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "frontend",
    "backend",
    "authorization",
    "llm_gateway",
    "Mobile",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun ./node_modules/turbo/bin/turbo run build",
    "build:production": "./scripts/production-build.sh build",
    "check": "bun run check:source && bun run check:dead-code && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:white-label-builds && bun run build",
    "certs:dev": "./scripts/generate-dev-certificates.sh",
    "check:source": "./scripts/check-typescript-source.sh && ./scripts/check-single-city-architecture.sh && bun scripts/check-public-repository.ts && bun scripts/check-mobile-build-assets.ts && bun scripts/sync-k8s-white-label.ts --check && bun scripts/check-deployment-baseline.ts && bun scripts/check-image-contract.ts && bun test ./scripts/test-infrastructure.ts --timeout 30000 && bun scripts/check-production-source-build.ts && bun scripts/check-cluster-configuration.ts && bun scripts/check-cluster-stateful-services.ts && bun scripts/check-cluster-workloads-security.ts && bun scripts/check-observability-profiles.ts && bun scripts/check-cluster-autoscaling.ts && bun scripts/check-redis-profiles.ts && bun scripts/check-redis-resilience.ts && bun scripts/check-production-compose.ts .env.production.example --images-env deploy/compose/images.env.example --matrix && bun scripts/test-production-compose-policy.ts && bun scripts/check-phase-12.ts && ./scripts/check-frontend-boundary.sh && ./scripts/test-frontend-boundary-policy.sh && ./scripts/check-frontend-design-system.sh && ./scripts/test-frontend-design-system-policy.sh && bun run test:dependency-policy && bun run check:workspaces && bun run test:bun-deployment-policy",
    "check:cluster-config": "bun scripts/check-cluster-configuration.ts",
    "check:cluster-stateful": "bun scripts/check-cluster-stateful-services.ts",
    "check:cluster-workloads-security": "bun scripts/check-cluster-workloads-security.ts",
    "check:deployment-baseline": "bun scripts/check-deployment-baseline.ts",
    "check:dead-code": "bun run --filter @zglosto/contracts build && bun run --filter @zglosto/white-label-config build && ZGLOSTO_STATIC_ANALYSIS=1 bun run --bun knip",
    "check:image-contract": "bun scripts/check-image-contract.ts",
    "check:images:local": "bun scripts/check-image-contract.ts --inspect --mode baseline",
    "check:images:target": "bun scripts/check-image-contract.ts --inspect --mode target",
    "check:observability": "bun scripts/check-observability-profiles.ts",
    "check:redis": "bun scripts/check-redis-profiles.ts",
    "check:redis-resilience": "bun scripts/check-redis-resilience.ts",
    "check:cluster-autoscaling": "bun scripts/check-cluster-autoscaling.ts",
    "check:production-compose": "bun scripts/check-production-compose.ts .env.production.example --images-env deploy/compose/images.env.example --matrix",
    "check:production-build": "bun scripts/check-production-source-build.ts",
    "check:phase12": "bun scripts/check-phase-12.ts",
    "check:public-repository": "bun scripts/check-public-repository.ts",
    "check:mobile-build-assets": "bun scripts/check-mobile-build-assets.ts",
    "check:mobile-client-configs": "bun run --filter @zglosto/contracts build && bun run --filter @zglosto/white-label-config build && bun scripts/check-mobile-client-configs.mjs",
    "validate:production-build": "./scripts/production-build.sh validate",
    "config:metadata": "bun run --filter @zglosto/contracts --filter @zglosto/white-label-config build && bun packages/white-label-config/dist/cli.js",
    "config:k8s:sync": "bun scripts/sync-k8s-white-label.ts",
    "deps:add": "bun scripts/dependencies.ts add",
    "deps:install": "bun scripts/dependencies.ts install",
    "deps:update": "bun scripts/dependencies.ts update",
    "dev:authorization": "bun run --filter authorization-zglosto dev",
    "dev:backend": "bun run --filter backend-zglosto dev",
    "dev:frontend": "bun run --filter frontend-zglosto dev",
    "mobile:demo:android": "./scripts/mobile-demo.sh android",
    "mobile:demo:check": "./scripts/mobile-demo.sh check",
    "mobile:demo:clean": "./scripts/mobile-demo.sh clean",
    "mobile:demo:down": "./scripts/mobile-demo.sh down",
    "mobile:demo:ios": "./scripts/mobile-demo.sh ios",
    "mobile:demo:seed": "./scripts/mobile-demo.sh seed",
    "mobile:demo:status": "./scripts/mobile-demo.sh status",
    "mobile:demo:up": "./scripts/mobile-demo.sh up",
    "mobile:regression": "./Mobile/scripts/run-phase7-regression.sh",
    "lint": "bun run --bun oxlint",
    "lint:fix": "bun run --bun oxlint --fix",
    "format": "bun run --bun oxfmt",
    "format:check": "bun run --bun oxfmt --check",
    "prepare": "bun run --bun husky || true",
    "test": "bun ./node_modules/turbo/bin/turbo run test",
    "test:white-label-builds": "./scripts/test-white-label-builds.sh",
    "test:integration": "./scripts/test-phase0-integration.sh",
    "test:redis-failure": "./scripts/test-redis-failure.sh",
    "test:deployment:compose": "./scripts/test-phase0-integration.sh",
    "test:deployment:kubernetes": "./scripts/test-cluster-profile.sh kubernetes",
    "test:deployment:k3s": "./scripts/test-cluster-profile.sh k3s",
    "typecheck": "bun ./node_modules/turbo/bin/turbo run typecheck && bun run typecheck:integration",
    "typecheck:integration": "bun run --bun tsc -p tests/integration/tsconfig.json --noEmit",
    "quality:phase1": "bun run check && bun run test:integration",
    "release:production:static": "./scripts/production-release-gate.sh static",
    "release:production:validate": "./scripts/production-release-gate.sh validate",
    "release:production:runtime": "./scripts/production-release-gate.sh runtime",
    "test:production-compose-policy": "bun scripts/test-production-compose-policy.ts",
    "audit:release": "bun scripts/check-release-dependency-risk.ts",
    "release:manifest": "bun scripts/generate-release-file-manifest.ts",
    "release:verify-source-copy": "bun scripts/verify-release-source-copy.ts",
    "phase12:static": "./scripts/phase12-certify.sh static",
    "phase12:host": "./scripts/phase12-certify.sh host",
    "phase12:dmr": "./scripts/phase12-certify.sh dmr",
    "phase12:edge": "./scripts/phase12-certify.sh edge",
    "phase12:soak": "./scripts/phase12-certify.sh soak",
    "phase12:observability": "./scripts/phase12-certify.sh observability",
    "phase12:integration:minimal": "./scripts/phase12-certify.sh integration-minimal",
    "phase12:integration:recommended": "./scripts/phase12-certify.sh integration-recommended",
    "phase12:load": "./scripts/phase12-certify.sh load",
    "phase12:resources:minimal": "./scripts/phase12-resource-profile.sh minimal",
    "phase12:resources:observability": "./scripts/phase12-resource-profile.sh observability",
    "phase12:resources:recommended": "./scripts/phase12-resource-profile.sh recommended",
    "phase12:production": "./scripts/phase12-certify.sh production-runtime",
    "test:auth-provisioning": "bun scripts/test-auth-provisioning.ts",
    "test:infrastructure": "bun test ./scripts/test-infrastructure.ts --timeout 30000",
    "check:cluster-production": "bun scripts/check-cluster-production.ts",
    "test:dependency-policy": "bun test ./scripts/test-dependency-policy.ts --timeout 30000 ./scripts/test-bun-review-fixes.ts",
    "check:workspaces": "bun scripts/check-bun-workspaces.ts",
    "test:runtime:bun": "bun scripts/bun-phase1-probe.ts && bun scripts/bun-phase1-otel-probe.ts --sigterm",
    "test:bun-deployment": "bun scripts/bun-deployment-drill.ts",
    "test:bun-deployment-policy": "bun run --bun tsc -p scripts/tsconfig.bun-deployment.json && bun test ./scripts/test-bun-deployment.ts --timeout 30000"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@shadcn/lint": "0.1.1",
    "@types/node": "26.6.2",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "sfw": "2.0.6",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@expo/plist>@xmldom/xmldom": "0.8.15",
    "@expo/xcpretty>js-yaml": "4.3.2",
    "cosmiconfig>js-yaml": "4.3.2",
    "plist>@xmldom/xmldom": "0.9.12",
    "qs": "6.16.0",
    "query-string>decode-uri-component": "0.5.0",
    "xcode>uuid": "11.1.1",
    "xmlbuilder2>js-yaml": "4.3.2"
  },
  "engines": {
    "node": ">=26.8.1"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@nestjs/core",
    "esbuild",
    "protobufjs"
  ]
}
